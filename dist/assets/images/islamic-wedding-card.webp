<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 520" width="100%" height="100%">
  <defs>
    <linearGradient id="skyGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stopColor="#2c0610" />
      <stop offset="45%" stopColor="#4d0e1e" />
      <stop offset="75%" stopColor="#7a1c30" />
      <stop offset="100%" stopColor="#a33649" />
    </linearGradient>

    <radialGradient id="sunGlow" cx="50%" cy="40%" r="55%">
      <stop offset="0%" stopColor="#fff5d6" stopOpacity="1" />
      <stop offset="35%" stopColor="#f5c258" stopOpacity="0.8" />
      <stop offset="70%" stopColor="#d4af37" stopOpacity="0.3" />
      <stop offset="100%" stopColor="#d4af37" stopOpacity="0" />
    </radialGradient>

    <linearGradient id="goldArch" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stopColor="#fcedc5" />
      <stop offset="25%" stopColor="#dfba73" />
      <stop offset="50%" stopColor="#fff2cf" />
      <stop offset="75%" stopColor="#c59b27" />
      <stop offset="100%" stopColor="#fcedc5" />
    </linearGradient>

    <filter id="softGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="3" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  {/* Sky Background */}
  <rect width="800" height="520" fill="url(#skyGrad)" />

  {/* Radial Golden Sun / Moon Glow */}
  <circle cx="400" cy="220" r="240" fill="url(#sunGlow)" />

  {/* Distant Palace Silhouettes & Minarets */}
  <g fill="#1f030a" opacity="0.85">
    {/* Center Dome */}
    <path d="M 330 380 C 330 300, 370 250, 400 220 C 430 250, 470 300, 470 380 Z" />
    <rect x="320" y="380" width="160" height="140" />
    {/* Minarets */}
    <rect x="180" y="240" width="22" height="280" />
    <path d="M 180 240 L 191 190 L 202 240 Z" />
    <circle cx="191" cy="186" r="3" fill="#dfba73" />

    <rect x="598" y="240" width="22" height="280" />
    <path d="M 598 240 L 609 190 L 620 240 Z" />
    <circle cx="609" cy="186" r="3" fill="#dfba73" />

    {/* Side Domes */}
    <path d="M 230 370 C 230 320, 260 280, 280 260 C 300 280, 330 320, 330 370 Z" />
    <path d="M 470 370 C 470 320, 500 280, 520 260 C 540 280, 570 320, 570 370 Z" />
  </g>

  {/* Magnificent Foreground Islamic Multi-Cusped Archway */}
  <g fill="#160206">
    <path d="M 0 0 L 800 0 L 800 520 L 720 520 L 720 220 C 720 220, 620 80, 400 40 C 180 80, 80 220, 80 220 L 80 520 L 0 520 Z" />
  </g>

  {/* Golden Arch Moldings & Cusps */}
  <path
    d="M 80 240 C 130 210, 190 140, 270 100 C 320 75, 370 50, 400 40 C 430 50, 480 75, 530 100 C 610 140, 670 210, 720 240"
    stroke="url(#goldArch)"
    strokeWidth="5"
    fill="none"
    filter="url(#softGlow)"
  />
  <path
    d="M 95 255 C 145 225, 205 155, 285 115 C 330 90, 375 65, 400 55 C 425 65, 470 90, 515 115 C 595 155, 655 225, 705 255"
    stroke="#dfba73"
    strokeWidth="1.8"
    fill="none"
    opacity="0.8"
  />

  {/* Hanging Ornate Brass Lanterns (Fanoos) */}
  <g>
    {/* Left Lantern */}
    <line x1="200" y1="0" x2="200" y2="180" stroke="#dfba73" strokeWidth="2" />
    <circle cx="200" cy="200" r="40" fill="url(#sunGlow)" opacity="0.6" />
    <path d="M 185 180 L 215 180 L 225 210 L 200 240 L 175 210 Z" fill="#2b050f" stroke="#dfba73" strokeWidth="2" />
    <circle cx="200" cy="205" r="5" fill="#fff7d6" filter="url(#softGlow)" />

    {/* Right Lantern */}
    <line x1="600" y1="0" x2="600" y2="180" stroke="#dfba73" strokeWidth="2" />
    <circle cx="600" cy="200" r="40" fill="url(#sunGlow)" opacity="0.6" />
    <path d="M 585 180 L 615 180 L 625 210 L 600 240 L 575 210 Z" fill="#2b050f" stroke="#dfba73" strokeWidth="2" />
    <circle cx="600" cy="205" r="5" fill="#fff7d6" filter="url(#softGlow)" />
  </g>

  {/* Floral Arabesque Garland across Arch Base */}
  <g stroke="#dfba73" strokeWidth="1.2" fill="none" opacity="0.7">
    <path d="M 100 500 C 200 480, 300 490, 400 480 C 500 490, 600 480, 700 500" />
    <circle cx="400" cy="480" r="4" fill="#dfba73" />
    <circle cx="250" cy="485" r="3" fill="#dfba73" />
    <circle cx="550" cy="485" r="3" fill="#dfba73" />
  </g>
</svg>
